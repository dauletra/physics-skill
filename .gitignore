# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.python-version

# Python build and packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheelhouse/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
venv.bak/

# Test, coverage and type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/

# Local environment and secrets
.env
.env.*
!.env.example

# IDE/editor settings
.idea/
.vscode/
.claude/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
~$*

# Node/tooling caches, in case browser tooling is added
node_modules/
.npm/
.pnpm-store/
.yarn/

# Generated worksheet previews and exports
preview-worksheet/
*.preview.html
**/output/
*.docx
*.pdf

# Render/runtime artifacts
*.svg.tmp
*.bak

# Misc project-local caches
.cache/
.ropeproject/
