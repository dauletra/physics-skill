{
  "document": {
    "$defs": {
      "HeaderModel": {
        "additionalProperties": false,
        "description": "Анкета-шапка (нужна самостоятельной работе, не нужна конспекту):\nстрока «Школа/класс … Дата … Фамилия Имя …», подзаголовок из\nпредмета/класса и строка-инструкция. Поля пустые — соответствующие\nкуски шапки не печатаются.",
        "properties": {
          "school": {
            "default": "",
            "title": "School",
            "type": "string"
          },
          "date": {
            "default": "",
            "title": "Date",
            "type": "string"
          },
          "subject": {
            "default": "",
            "title": "Subject",
            "type": "string"
          },
          "grade": {
            "default": "",
            "title": "Grade",
            "type": "string"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instructions"
          }
        },
        "title": "HeaderModel",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Манифест документа (document.json): заголовок, опциональная\nанкета-шапка и порядок верхнеуровневых блоков. Сами блоки живут в\nblocks/<id>.json — по файлу на блок, чтобы точечная правка трогала\nодин маленький файл.",
    "properties": {
      "title": {
        "default": "",
        "title": "Title",
        "type": "string"
      },
      "header": {
        "anyOf": [
          {
            "$ref": "#/$defs/HeaderModel"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "order": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Order"
      }
    },
    "title": "DocumentModel",
    "type": "object"
  },
